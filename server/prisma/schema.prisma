generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model AppConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key")
  configValue String   @map("config_value")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_configs")
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  eventId    String   @unique @map("event_id")
  userId     Int?     @map("user_id")
  eventName  String   @map("event_name")
  eventTime  DateTime @map("event_time")
  platform   String   @default("")
  page       String   @default("")
  sessionId  String   @default("") @map("session_id")
  deviceId   String   @default("") @map("device_id")
  properties String   @default("{}")
  rawPayload String   @default("{}") @map("raw_payload")
  ip         String   @default("")
  userAgent  String   @default("") @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventName])
  @@index([userId])
  @@index([eventTime])
  @@map("analytics_events")
}

model Task {
  id         Int      @id @default(autoincrement())
  taskId     String   @unique @map("task_id")
  taskName   String   @map("task_name")
  taskType   String   @default("server_task") @map("task_type")
  targetClientId String? @map("target_client_id")
  claimedByClientId String? @map("claimed_by_client_id")
  taskParams String   @map("task_params")
  status     String   @default("queued")
  statusInfo String   @default("{}") @map("status_info")
  executionLog String @default("") @map("execution_log")
  resultCode Int? @map("result_code")
  claimedAt  DateTime? @map("claimed_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  maxRetries Int @default(0) @map("max_retries")
  retryCount Int @default(0) @map("retry_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status, taskType])
  @@map("tasks")
}

model ExecutorClient {
  id            Int      @id @default(autoincrement())
  clientId      String   @unique @map("client_id")
  name          String
  platform      String   @default("darwin")
  appVersion    String   @default("unknown") @map("app_version")
  tags          String   @default("[]")
  capabilities  String   @default("{}")
  status        String   @default("online")
  ip            String?
  lastHeartbeat DateTime @default(now()) @map("last_heartbeat")
  tasksClaimed  Int      @default(0) @map("tasks_claimed")
  tasksSuccess  Int      @default(0) @map("tasks_success")
  tasksFailed   Int      @default(0) @map("tasks_failed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("executor_clients")
}

// ── DeepRead ────────────────────────────────────────────

model DrUser {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  nickname  String   @default("")
  avatar    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("dr_users")
}

model DrSmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([phone, used, expiresAt])
  @@map("dr_sms_codes")
}

model DrSpace {
  id           Int      @id @default(autoincrement())
  spaceId      String   @unique @map("space_id")
  name         String
  description  String   @default("")
  inviteCode   String   @unique @map("invite_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("dr_spaces")
}

model DrSpaceMember {
  id           Int      @id @default(autoincrement())
  spaceId      String   @map("space_id")
  userId       Int      @map("user_id")
  role         String   @default("member")
  inviteCodeId String?  @map("invite_code_id")
  joinedAt     DateTime @default(now()) @map("joined_at")
  @@unique([spaceId, userId])
  @@index([userId])
  @@map("dr_space_members")
}

model DrInviteCode {
  id        Int       @id @default(autoincrement())
  codeId    String    @unique @map("code_id")
  spaceId   String    @map("space_id")
  code      String    @unique
  label     String    @default("")
  maxUses   Int?      @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  expiresAt DateTime? @map("expires_at")
  disabled  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  @@map("dr_invite_codes")
}

model DrChannel {
  id        Int      @id @default(autoincrement())
  channelId String   @unique @map("channel_id")
  spaceId   String   @map("space_id")
  name      String
  coverUrl  String   @default("") @map("cover_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([spaceId])
  @@map("dr_channels")
}

model DrArticle {
  id          Int      @id @default(autoincrement())
  articleId   String   @unique @map("article_id")
  spaceId     String   @map("space_id")
  channelId   String   @map("channel_id")
  title       String
  summary     String   @default("")
  coverUrl    String   @default("") @map("cover_url")
  layoutType  String   @default("default") @map("layout_type")
  contentType String   @default("html") @map("content_type")
  content     String   @default("") @map("content_html")
  author      String   @default("")
  readCount   Int      @default(0) @map("read_count")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([spaceId])
  @@index([channelId])
  @@map("dr_articles")
}

model DrSpaceHomepageModule {
  id           Int      @id @default(autoincrement())
  moduleId     String   @unique @map("module_id")
  spaceId      String   @map("space_id")
  moduleType   String   @default("standard") @map("module_type")
  title        String
  subtitle     String   @default("")
  description  String   @default("")
  layoutType   String   @default("large_horizontal") @map("layout_type")
  sourceType   String   @default("") @map("source_type")
  sourceId     String   @default("") @map("source_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([spaceId])
  @@map("dr_space_homepage_modules")
}

model DrSpaceHomepageModuleResource {
  id           Int      @id @default(autoincrement())
  moduleId     String   @map("module_id")
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  @@unique([moduleId, resourceId])
  @@map("dr_space_homepage_module_resources")
}


model DrHighlight {
  id           Int      @id @default(autoincrement())
  highlightId  String   @unique @map("highlight_id")
  userId       Int      @map("user_id")
  articleId    String   @map("article_id")
  text         String
  color        String   @default("#FFEB3B")
  positionData String   @default("{}") @map("position_data")
  note         String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([userId])
  @@index([articleId])
  @@map("dr_highlights")
}

model DrCollection {
  id           Int      @id @default(autoincrement())
  collectionId String   @unique @map("collection_id")
  userId       Int      @map("user_id")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("dr_collections")
}

model DrCollectionArticle {
  id           Int      @id @default(autoincrement())
  collectionId String   @map("collection_id")
  articleId    String   @map("article_id")
  addedAt      DateTime @default(now()) @map("added_at")
  @@unique([collectionId, articleId])
  @@map("dr_collection_articles")
}

model DrSpaceCollection {
  id           Int      @id @default(autoincrement())
  collectionId String   @unique @map("collection_id")
  spaceId      String   @map("space_id")
  name         String
  description  String   @default("")
  coverUrl     String   @default("") @map("cover_url")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("dr_space_collections")
}

model DrSpaceCollectionArticle {
  id           Int      @id @default(autoincrement())
  collectionId String   @map("collection_id")
  articleId    String   @map("article_id")
  sortOrder    Int      @default(0) @map("sort_order")
  addedAt      DateTime @default(now()) @map("added_at")
  @@unique([collectionId, articleId])
  @@index([collectionId])
  @@map("dr_space_collection_articles")
}

// ── AI 配置 ────────────────────────────────────────────────

model DrAiProvider {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  baseUrl   String      @map("base_url")
  apiKey    String      @map("api_key")
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  models    DrAiModel[]

  @@map("dr_ai_providers")
}

model DrAiModel {
  id                Int          @id @default(autoincrement())
  providerId        Int          @map("provider_id")
  model             String
  enabled           Boolean      @default(true)
  costPerUse        Int          @default(1) @map("cost_per_use")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")
  provider          DrAiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
  @@map("dr_ai_models")
}

model DrAiQuota {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  dailyLimit Int      @map("daily_limit")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dr_ai_quotas")
}

model DrAiUsage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  date      String
  consumed  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("dr_ai_usages")
}

// ── 每日精选 ──────────────────────────────────────────────

model DrDailyPickLattice {
  id             Int      @id @default(autoincrement())
  latticeId      String   @unique @map("lattice_id")
  spaceId        String   @map("space_id")
  collectionId   String   @map("collection_id")
  recommendation String   @default("")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([spaceId, enabled])
  @@map("dr_daily_pick_lattices")
}

model DrDailyPickArticle {
  id        Int      @id @default(autoincrement())
  pickId    String   @unique @map("pick_id")
  spaceId   String   @map("space_id")
  articleId String   @map("article_id")
  reason    String   @default("") @map("reason")
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([spaceId, enabled])
  @@map("dr_daily_pick_articles")
}

model DrEditorHighlight {
  id             Int      @id @default(autoincrement())
  highlightId    String   @unique @map("highlight_id")
  articleId      String   @map("article_id")
  text           String
  color          String   @default("#FFD700")
  positionData   String   @default("{}") @map("position_data")
  note           String   @default("")
  contextBefore  String   @default("") @map("context_before")
  contextAfter   String   @default("") @map("context_after")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("dr_editor_highlights")
}

// ── 数据同步 ────────────────────────────────────────────────

model DrSyncBackup {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  data      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dr_sync_backups")
}

// ── 阅读统计 ────────────────────────────────────────────────

model DrReadingStats {
  id                Int      @id @default(autoincrement())
  statsId           String   @unique @map("stats_id")
  userId            Int      @map("user_id")
  articleId         String   @map("article_id")
  readingTimeMs     Int      @default(0) @map("reading_time_ms")
  scrollDepth       Int      @default(0) @map("scroll_depth")
  sessionStart      DateTime @map("session_start")
  sessionEnd        DateTime @map("session_end")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([articleId])
  @@index([createdAt])
  @@map("dr_reading_stats")
}
