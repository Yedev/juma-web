# ── JUMA Web 基础服务配置 ──────────────────────────────────────

# 监听端口，默认 3001
PORT=3001

# 数据库连接 
# (本地开发通常为 file:./dev.db，Docker 部署时会被设置为 file:/app/data/juma.db)
DATABASE_URL="file:./dev.db"

# ── 认证相关密钥配置 ──────────────────────────────────────────
# 警告：请在生产环境中修改为更复杂且随机的字符串！

# 管理后台登录态 Token 签名密钥
JWT_SECRET="juma_jwt_secret_2026"

# 移动端 API 接口防篡改签名密钥 (参与生成 x-sign 请求头)
APP_SECRET="juma2026_secret"

# DeepRead 服务专属 Token 签名密钥
DR_JWT_SECRET="deepread_jwt_secret_2026"


# ── 分布式执行器 (Executor) 引擎配置 ───────────────────────────

# 执行器集群共享安全密钥 (远程节点连接鉴权)
EXECUTOR_SHARED_KEY="juma_executor_2026"

# 本地执行器轮询任务的时间间隔 (毫秒)
LOCAL_EXECUTOR_POLL_MS=2000

# 本地执行器支持的最大并发任务数
LOCAL_EXECUTOR_CONCURRENCY=1

# 调度中心向各个执行节点派发任务的时间间隔 (毫秒)
EXECUTOR_DISPATCH_INTERVAL_MS=1500

# 远程节点向调度中心发送心跳的时间间隔 (毫秒)
EXECUTOR_HEARTBEAT_INTERVAL_MS=10000

# 判定远程执行节点离线的超时时间 (毫秒，超过此时间无心跳即视为离线)
EXECUTOR_OFFLINE_TIMEOUT_MS=60000

# 清理已离线节点及其被中断任务的检查周期 (毫秒)
EXECUTOR_SWEEP_INTERVAL_MS=10000

# 判定远程任务僵死并强制重新分配的超时时间 (毫秒)
REMOTE_TASK_STALE_TIMEOUT_MS=300000

# 任务执行日志的单条最大字节数限制
TASK_LOG_MAX_BYTES=65536


# ── JUMA Admin-UI 前端环境变量 (仅构建期及本地生效) ───────────────

# 请求后端的 API 根路径 (本地开发为空即代理至 3001，若前后端分离部署可填入后端完整域名)
VITE_API_BASE_URL=""
